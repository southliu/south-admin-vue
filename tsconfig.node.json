{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": [
    "vite.config.ts",
    "uno.config.ts",
    "build/**/*.ts"
  ]
}
