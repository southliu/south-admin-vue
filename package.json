{
  "name": "vue-admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://github.com/southliu/vue-admin",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "build:dev": "vue-tsc --noEmit && vite build --mode development",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "preview": "vite preview",
    "report": "cross-env REPORT=true npm run build",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "postinstall": "husky install",
    "init:project": "node .claude/skills/init-project/scripts/init.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@iconify-json/ant-design": "^1.2.8",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/gridicons": "^1.2.5",
    "@iconify-json/icon-park": "^1.2.4",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/uil": "^1.2.3",
    "@iconify/vue": "^5.0.0",
    "@vueuse/core": "^13.0.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.3",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.0.3",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.8",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@unocss/preset-attributify": "66.5.12",
    "@unocss/preset-icons": "66.5.12",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.0",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "stylelint": "^16.26.1",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "unocss": "66.5.12",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
