{
  "name": "vue-admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://github.com/southliu/vue-admin",
  "scripts": {
    "dev": "pnpm icons && vite --host",
    "build": "pnpm icons && vue-tsc --noEmit && vite build --mode production",
    "build:dev": "pnpm icons && vue-tsc --noEmit && vite build --mode development",
    "build:test": "pnpm icons && vue-tsc --noEmit && vite build --mode test",
    "preview": "vite preview",
    "report": "cross-env REPORT=true npm run build",
    "lint": "eslint .",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "postinstall": "husky",
    "init:project": "node .claude/skills/init-project/scripts/init.mjs",
    "typecheck": "vue-tsc --noEmit && node node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.node.json",
    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@iconify-json/ant-design": "^1.2.9",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/gridicons": "^1.2.5",
    "@iconify-json/icon-park": "^1.2.4",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/ion": "^1.2.8",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/uil": "^1.2.3",
    "@iconify/vue": "^5.0.5",
    "@vueuse/core": "^15.1.0",
    "@wangeditor-next/editor": "^6.7.0",
    "@wangeditor-next/editor-for-vue": "^6.7.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.21.1",
    "crypto-es": "^3.1.3",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.24",
    "vue-router": "^5.5.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@iconify-json/fluent": "^1.2.62",
    "@iconify-json/la": "^1.2.1",
    "@iconify-json/majesticons": "^1.2.5",
    "@iconify-json/material-symbols": "^1.2.101",
    "@types/node": "^26.6.11",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@unocss/preset-attributify": "^66.13.0",
    "@unocss/preset-icons": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "postcss-html": "^2.0.1",
    "postcss-less": "^8.1.0",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.3.0",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "unocss": "^66.13.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.4.0",
    "vite-plugin-compression": "^0.5.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.6.0"
}
