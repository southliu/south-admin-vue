{
  "demoApi": {
    "scope": "typescript",
    "prefix": "demoApi",
    "description": "生成标准 CRUD API 接口文件",
    "body": [
      "import type { BaseFormData } from '#/form';",
      "import type { PageServerResult, PaginationData } from '#/public';",
      "import { request } from '@/servers';",
      "",
      "enum API {",
      "  URL = '/xxx',",
      "}",
      "",
      "/**",
      " * 获取分页数据",
      " * @param data - 请求数据",
      " */",
      "export function getXXXPage(data: Partial<BaseFormData> & PaginationData) {",
      "  return request.get<PageServerResult<BaseFormData[]>>(`${API.URL}/page`, { params: data });",
      "}",
      "",
      "/**",
      " * 根据ID获取数据",
      " * @param id - ID",
      " */",
      "export function getXXXById(id: string) {",
      "  return request.get<BaseFormData>(`${API.URL}/detail?id=${id}`);",
      "}",
      "",
      "/**",
      " * 新增数据",
      " * @param data - 请求数据",
      " */",
      "export function createXXX(data: BaseFormData) {",
      "  return request.post(`${API.URL}/create`, data);",
      "}",
      "",
      "/**",
      " * 修改数据",
      " * @param id - 修改id值",
      " * @param data - 请求数据",
      " */",
      "export function updateXXX(id: string, data: BaseFormData) {",
      "  return request.put(`${API.URL}/update/${id}`, data);",
      "}",
      "",
      "/**",
      " * 删除",
      " * @param id - 删除id值",
      " */",
      "export function deleteXXX(id: string) {",
      "  return request.delete(`${API.URL}/${id}`);",
      "}",
      "",
      "/**",
      " * 批量删除",
      " * @param data - 请求数据",
      " */",
      "export function batchDeleteXXX(data: BaseFormData) {",
      "  return request.post(`${API.URL}/batchDelete`, data);",
      "}"
    ]
  },
  "demoModel": {
    "scope": "typescript",
    "prefix": "demoModel",
    "description": "生成标准 CRUD 数据模型文件",
    "body": [
      "import type { BaseFormList, BaseSearchList } from '#/form';",
      "import type { TableColumn } from '#/public';",
      "import type { Translate } from '@/utils/config';",
      "import { FORM_REQUIRED } from '@/utils/config';",
      "",
      "// 搜索数据",
      "export const searchList = (t: Translate): BaseSearchList[] => [",
      "  {",
      "    label: t('public.name'),",
      "    name: 'name',",
      "    wrapperWidth: 200,",
      "    component: 'Input',",
      "  },",
      "];",
      "",
      "/**",
      " * 表格数据",
      " */",
      "export const tableColumns = (t: Translate): TableColumn[] => {",
      "  return [",
      "    {",
      "      title: 'ID',",
      "      dataIndex: 'id',",
      "      width: 80,",
      "      fixed: 'left',",
      "    },",
      "    {",
      "      title: t('public.name'),",
      "      dataIndex: 'name',",
      "      width: 200,",
      "    },",
      "    {",
      "      title: t('public.creationTime'),",
      "      dataIndex: 'createdAt',",
      "      width: 200,",
      "    },",
      "    {",
      "      title: t('public.updateTime'),",
      "      dataIndex: 'updatedAt',",
      "      width: 200,",
      "    },",
      "    {",
      "      title: t('public.operate'),",
      "      dataIndex: 'operate',",
      "      width: 200,",
      "      fixed: 'right',",
      "    },",
      "  ];",
      "};",
      "",
      "/**",
      " * 新增数据",
      " */",
      "export const createList = (t: Translate): BaseFormList[] => [",
      "  {",
      "    label: t('public.name'),",
      "    name: 'name',",
      "    rules: FORM_REQUIRED,",
      "    component: 'Input',",
      "  },",
      "];"
    ]
  },
  "demoPage": {
    "scope": "vue",
    "prefix": "demoPage",
    "description": "生成标准 CRUD 列表页面（弹窗模式）",
    "body": [
      "<script setup lang=\"ts\">",
      "import type { BaseFormData } from '#/form';",
      "import type { Key } from 'ant-design-vue/es/table/interface';",
      "import { useI18n } from 'vue-i18n';",
      "import { computed, onActivated, onMounted, ref, useTemplateRef } from 'vue';",
      "import {",
      "  batchDeleteXXX,",
      "  createXXX,",
      "  deleteXXX,",
      "  getXXXById,",
      "  getXXXPage,",
      "  updateXXX,",
      "} from '@/servers/xxx';",
      "import BaseCard from '@/components/Card/BaseCard.vue';",
      "import BaseContent from '@/components/Content/BaseContent.vue';",
      "import BaseSearch from '@/components/Search/BaseSearch.vue';",
      "import BaseTable from '@/components/Table/BaseTable.vue';",
      "import BasePagination from '@/components/Pagination/BasePagination.vue';",
      "import BaseModal from '@/components/Modal/BaseModal.vue';",
      "import BaseForm from '@/components/Form/BaseForm.vue';",
      "import UpdateBtn from '@/components/Buttons/UpdateBtn.vue';",
      "import DeleteBtn from '@/components/Buttons/DeleteBtn.vue';",
      "import { checkPermission } from '@/utils/permissions';",
      "import { ADD_TITLE, EDIT_TITLE, INIT_PAGINATION } from '@/utils/config';",
      "import { message } from '@/utils/message';",
      "import { useCommonStore } from '@/hooks/useCommonStore';",
      "import { searchList, tableColumns, createList } from './model';",
      "",
      "// keep-alive 缓存名（路由路径 PascalCase，如 /system/product -> SystemProduct）",
      "defineOptions({ name: 'XXX' });",
      "",
      "// 当前行数据",
      "interface RowData {",
      "  id: string;",
      "}",
      "",
      "// 初始化新增数据",
      "const initCreate = {",
      "  status: 1,",
      "};",
      "",
      "const { t } = useI18n();",
      "const createFormRef = useTemplateRef<{ submit: () => void }>('createFormRef');",
      "",
      "const isLoading = ref(false);",
      "const isCreateLoading = ref(false);",
      "const isCreateOpen = ref(false);",
      "const createTitle = ref(ADD_TITLE(t));",
      "const createId = ref('');",
      "const createData = ref<BaseFormData>({ ...initCreate });",
      "const searchData = ref<BaseFormData>({});",
      "const page = ref(INIT_PAGINATION.page);",
      "const pageSize = ref(INIT_PAGINATION.pageSize);",
      "const total = ref(0);",
      "const tableData = ref<BaseFormData[]>([]);",
      "const selectedRowKeys = ref<Key[]>([]);",
      "",
      "const { permissions } = useCommonStore();",
      "",
      "// 权限前缀",
      "const permissionPrefix = '/xxx';",
      "",
      "// 权限",
      "const pagePermission = computed(() => checkPermission(permissionPrefix, permissions.value));",
      "",
      "/** 获取表格数据 */",
      "const getPage = async () => {",
      "  const params = { ...searchData.value, page: page.value, pageSize: pageSize.value };",
      "",
      "  try {",
      "    isLoading.value = true;",
      "    const { code, data } = await getXXXPage(params);",
      "    if (Number(code) !== 200) return;",
      "    const { items, total: resultTotal } = data;",
      "    total.value = resultTotal || 0;",
      "    tableData.value = items || [];",
      "  } finally {",
      "    isLoading.value = false;",
      "  }",
      "};",
      "",
      "// 首次进入自动加载接口数据",
      "onMounted(() => {",
      "  if (pagePermission.value.page) getPage();",
      "});",
      "",
      "// 每次进入调用（keep-alive 激活）",
      "onActivated(() => {",
      "  getPage();",
      "});",
      "",
      "/**",
      " * 点击搜索",
      " * @param values - 表单返回数据",
      " */",
      "const onSearch = (values: BaseFormData) => {",
      "  page.value = 1;",
      "  searchData.value = values;",
      "  getPage();",
      "};",
      "",
      "/** 点击新增 */",
      "const onCreate = () => {",
      "  isCreateOpen.value = true;",
      "  createTitle.value = ADD_TITLE(t);",
      "  createId.value = '';",
      "  createData.value = { ...initCreate };",
      "};",
      "",
      "/**",
      " * 点击编辑",
      " * @param id - 唯一值",
      " */",
      "const onUpdate = async (id: string) => {",
      "  try {",
      "    isCreateOpen.value = true;",
      "    createTitle.value = EDIT_TITLE(t, id);",
      "    createId.value = id;",
      "    isCreateLoading.value = true;",
      "    const { code, data } = await getXXXById(id);",
      "    if (Number(code) !== 200) return;",
      "    createData.value = data;",
      "  } finally {",
      "    isCreateLoading.value = false;",
      "  }",
      "};",
      "",
      "/** 表格提交 */",
      "const createSubmit = () => {",
      "  createFormRef.value?.submit();",
      "};",
      "",
      "/** 关闭新增/修改弹窗 */",
      "const closeCreate = () => {",
      "  isCreateOpen.value = false;",
      "};",
      "",
      "/**",
      " * 新增/编辑提交",
      " * @param values - 表单返回数据",
      " */",
      "const handleCreate = async (values: BaseFormData) => {",
      "  try {",
      "    isCreateLoading.value = true;",
      "    const request = () => (createId.value ? updateXXX(createId.value, values) : createXXX(values));",
      "    const { code, message: messageInfo } = await request();",
      "    if (Number(code) !== 200) return;",
      "    message.success(messageInfo || t('public.successfulOperation'));",
      "    isCreateOpen.value = false;",
      "    getPage();",
      "  } finally {",
      "    isCreateLoading.value = false;",
      "  }",
      "};",
      "",
      "/**",
      " * 点击删除",
      " * @param id - 唯一值",
      " */",
      "const onDelete = async (id: string) => {",
      "  try {",
      "    isLoading.value = true;",
      "    const { code, message: messageInfo } = await deleteXXX(id);",
      "    if (Number(code) === 200) {",
      "      message.success(messageInfo || t('public.successfullyDeleted'));",
      "      getPage();",
      "    }",
      "  } finally {",
      "    isLoading.value = false;",
      "  }",
      "};",
      "",
      "/** 处理批量删除 */",
      "const handleBatchDelete = async () => {",
      "  try {",
      "    if (!selectedRowKeys.value.length) {",
      "      return message.warning({",
      "        content: t('public.tableSelectWarning'),",
      "        key: 'pleaseSelect',",
      "      });",
      "    }",
      "    isLoading.value = true;",
      "    const { code, message: messageInfo } = await batchDeleteXXX({ ids: selectedRowKeys.value });",
      "    if (Number(code) === 200) {",
      "      message.success(messageInfo || t('public.successfullyDeleted'));",
      "      getPage();",
      "    }",
      "  } finally {",
      "    isLoading.value = false;",
      "  }",
      "};",
      "",
      "/**",
      " * 处理分页",
      " * @param currentPage - 当前页数",
      " * @param currentPageSize - 每页条数",
      " */",
      "const onChangePagination = (currentPage: number, currentPageSize: number) => {",
      "  page.value = currentPage;",
      "  pageSize.value = currentPageSize;",
      "  getPage();",
      "};",
      "",
      "/**",
      " * 监听表格多选变化",
      " */",
      "const onSelectChange = (keys: Key[]) => {",
      "  selectedRowKeys.value = keys;",
      "};",
      "",
      "// 表格多选",
      "const rowSelection = computed(() => ({",
      "  selectedRowKeys: selectedRowKeys.value,",
      "  onChange: onSelectChange,",
      "}));",
      "",
      "// 列配置",
      "const columns = computed(() => tableColumns(t));",
      "</script>",
      "",
      "<template>",
      "  <BaseContent :is-permission=\"pagePermission.page\">",
      "    <BaseCard>",
      "      <BaseSearch",
      "        :list=\"searchList(t)\"",
      "        :data=\"searchData\"",
      "        :is-loading=\"isLoading\"",
      "        @handle-finish=\"onSearch\"",
      "      />",
      "    </BaseCard>",
      "",
      "    <BaseCard class=\"mt-10px\">",
      "      <BaseTable",
      "        :is-loading=\"isLoading\"",
      "        :is-create=\"pagePermission.create\"",
      "        :columns=\"columns\"",
      "        :data-source=\"tableData\"",
      "        :row-selection=\"rowSelection\"",
      "        @get-page=\"getPage\"",
      "        @on-create=\"onCreate\"",
      "      >",
      "        <template #leftContent>",
      "          <DeleteBtn",
      "            is-icon",
      "            :is-loading=\"isLoading\"",
      "            btn-type=\"batchDelete\"",
      "            @handle-delete=\"handleBatchDelete\"",
      "          />",
      "        </template>",
      "",
      "        <template #bodyCell=\"{ column, record }\">",
      "          <template v-if=\"column.dataIndex === 'operate'\">",
      "            <div class=\"flex flex-wrap gap-5px\">",
      "              <UpdateBtn v-if=\"pagePermission.update\" @click=\"onUpdate((record as RowData).id)\" />",
      "              <DeleteBtn",
      "                v-if=\"pagePermission.delete\"",
      "                :name=\"String((record as RowData).id)\"",
      "                @handle-delete=\"onDelete((record as RowData).id)\"",
      "              />",
      "            </div>",
      "          </template>",
      "        </template>",
      "      </BaseTable>",
      "",
      "      <BasePagination",
      "        :disabled=\"isLoading\"",
      "        :current=\"page\"",
      "        :page-size=\"pageSize\"",
      "        :total=\"total\"",
      "        @change=\"onChangePagination\"",
      "      />",
      "    </BaseCard>",
      "",
      "    <BaseModal",
      "      :title=\"createTitle\"",
      "      :open=\"isCreateOpen\"",
      "      :is-loading=\"isCreateLoading\"",
      "      @ok=\"createSubmit\"",
      "      @cancel=\"closeCreate\"",
      "    >",
      "      <BaseForm",
      "        ref=\"createFormRef\"",
      "        :list=\"createList(t)\"",
      "        :label-col=\"{ span: 4 }\"",
      "        :data=\"createData\"",
      "        @handle-finish=\"handleCreate\"",
      "      />",
      "    </BaseModal>",
      "  </BaseContent>",
      "</template>"
    ]
  },
  "demoOptionPage": {
    "scope": "vue",
    "prefix": "demoOptionPage",
    "description": "生成标准 CRUD 独立操作页（新增/编辑页面）",
    "body": [
      "<script setup lang=\"ts\">",
      "import type { BaseFormData } from '#/form';",
      "import { Spin } from 'ant-design-vue';",
      "import { useI18n } from 'vue-i18n';",
      "import { computed, onActivated, onMounted, ref, useTemplateRef } from 'vue';",
      "import { useRoute, useRouter } from 'vue-router';",
      "import { getXXXById, createXXX, updateXXX } from '@/servers/xxx';",
      "import BaseCard from '@/components/Card/BaseCard.vue';",
      "import BaseContent from '@/components/Content/BaseContent.vue';",
      "import BaseForm from '@/components/Form/BaseForm.vue';",
      "import SubmitBottom from '@/components/Bottom/SubmitBottom.vue';",
      "import { checkPermission } from '@/utils/permissions';",
      "import { message } from '@/utils/message';",
      "import { useCommonStore } from '@/hooks/useCommonStore';",
      "import { useSingleTab } from '@/hooks/useSingleTab';",
      "import { usePublicStore } from '@/stores/public';",
      "import { useTabsStore } from '@/stores/tabs';",
      "import { createList } from './model';",
      "",
      "// keep-alive 缓存名（父路径 PascalCase + Option）",
      "defineOptions({ name: 'XXXOption' });",
      "",
      "// 初始化新增数据",
      "const initCreate = {",
      "  status: 1,",
      "};",
      "",
      "// 父路径",
      "const fatherPath = '/xxx';",
      "",
      "const { t } = useI18n();",
      "const route = useRoute();",
      "const router = useRouter();",
      "const createFormRef = useTemplateRef<{",
      "  submit: () => void;",
      "  resetFields: () => void;",
      "}>('createFormRef');",
      "const publicStore = usePublicStore();",
      "const tabsStore = useTabsStore();",
      "",
      "const id = (route.query.id as string) || '';",
      "const currentId = ref(id);",
      "const isLoading = ref(false);",
      "const createId = ref('');",
      "const createData = ref<BaseFormData>({ ...initCreate });",
      "",
      "const { permissions } = useCommonStore();",
      "",
      "// 单标签管理",
      "useSingleTab({",
      "  fatherPath,",
      "  zhTitle: id ? '编辑XXX' : '新增XXX',",
      "  enTitle: id ? 'Edit XXX' : 'Add XXX',",
      "});",
      "",
      "// 权限前缀",
      "const permissionPrefix = '/xxx';",
      "",
      "// 权限",
      "const pagePermission = computed(() => {",
      "  const result = checkPermission(permissionPrefix, permissions.value);",
      "  return {",
      "    create: result.create,",
      "    update: result.update,",
      "  };",
      "});",
      "",
      "/** 处理新增 */",
      "const handleCreate = () => {",
      "  createId.value = '';",
      "  createData.value = { ...initCreate };",
      "};",
      "",
      "/**",
      " * 处理编辑",
      " * @param id - 唯一值",
      " */",
      "const handleUpdate = async (id: string) => {",
      "  try {",
      "    createId.value = id;",
      "    isLoading.value = true;",
      "    const { code, data } = await getXXXById(id);",
      "    if (Number(code) !== 200) return;",
      "    createData.value = data;",
      "  } finally {",
      "    isLoading.value = false;",
      "  }",
      "};",
      "",
      "onMounted(() => {",
      "  if (id) {",
      "    handleUpdate(id);",
      "  } else {",
      "    handleCreate();",
      "  }",
      "});",
      "",
      "// 页面激活时检测url参数变化（新增/编辑切换）",
      "onActivated(() => {",
      "  const newId = (route.query.id as string) || '';",
      "",
      "  if (currentId.value !== newId) {",
      "    if (newId) {",
      "      handleUpdate(newId);",
      "    } else {",
      "      handleCreate();",
      "    }",
      "    currentId.value = newId;",
      "  }",
      "});",
      "",
      "/** 表格提交 */",
      "const handleSubmit = () => {",
      "  createFormRef.value?.submit();",
      "};",
      "",
      "/**",
      " * 返回主页",
      " * @param isRefresh - 返回页面是否重新加载接口",
      " */",
      "const goBack = (isRefresh?: boolean) => {",
      "  createFormRef.value?.resetFields();",
      "  if (isRefresh) publicStore.setRefreshPage(true);",
      "  tabsStore.closeTabGoNext({",
      "    key: route.path + (route.fullPath.replace(route.path, '') || ''),",
      "    nextPath: fatherPath,",
      "  });",
      "  router.push(fatherPath);",
      "};",
      "",
      "/**",
      " * 新增/编辑提交",
      " * @param values - 表单返回数据",
      " */",
      "const handleFinish = async (values: BaseFormData) => {",
      "  try {",
      "    isLoading.value = true;",
      "    const request = () => (createId.value ? updateXXX(createId.value, values) : createXXX(values));",
      "    const { code, message: messageInfo } = await request();",
      "    if (Number(code) !== 200) return;",
      "    message.success(messageInfo || t('public.successfulOperation'));",
      "    createFormRef.value?.resetFields();",
      "    goBack(true);",
      "  } finally {",
      "    isLoading.value = false;",
      "  }",
      "};",
      "</script>",
      "",
      "<template>",
      "  <BaseContent :is-permission=\"id ? pagePermission.update : pagePermission.create\">",
      "    <div class=\"!h-[calc(100vh-98px)]\">",
      "      <BaseCard>",
      "        <div class=\"mt-20px mb-50px\">",
      "          <Spin :spinning=\"isLoading\">",
      "            <BaseForm",
      "              ref=\"createFormRef\"",
      "              :list=\"createList(t)\"",
      "              :data=\"createData\"",
      "              :label-col=\"{ span: 5 }\"",
      "              @handle-finish=\"handleFinish\"",
      "            />",
      "          </Spin>",
      "        </div>",
      "",
      "        <SubmitBottom :is-loading=\"isLoading\" :back-path=\"fatherPath\" @handle-confirm=\"handleSubmit\" />",
      "      </BaseCard>",
      "    </div>",
      "  </BaseContent>",
      "</template>"
    ]
  }
}
